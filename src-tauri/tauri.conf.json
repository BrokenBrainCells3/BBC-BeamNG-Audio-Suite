{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrokenBrainCells BeamNG DSP And Audio Suite",
  "version": "0.1.0",
  "identifier": "com.audio.app.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
          "label": "main",
          "title": "BrokenBrainCells BeamNG DSP And Audio Suite",
          "width": 1280,
          "height": 720,
          "resizable": false,
        "fullscreen": false,
        "devtools": false 
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' asset: https://asset.localhost",
        "style-src": "'self' asset: https://asset.localhost 'unsafe-inline'",
        "img-src": "'self' asset: https://asset.localhost data: blob:",
        "connect-src": "'self' ws: wss: http: https: tauri: ipc: http://localhost:* http://127.0.0.1:*",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "icons/*"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false,
      "scope": ["**"]
    }
  }
}
